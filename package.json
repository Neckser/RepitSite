{
  "name": "repitsite",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "tsc": "tsc",
    "esbuild": "node build.mjs",
    "eslint:check": "eslint . --ext .js",
    "eslint:fix": "eslint . --ext .js --fix",
    "stylelint:check": "stylelint \"**/*.{css,scss,sass}\"",
    "stylelint:fix": "stylelint \"**/*.{css,scss,sass}\" --fix",
    "prettier:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,sass,md,html}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,sass,md,html}\""
  },
  "devDependencies": {
    "esbuild": "^0.27.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.3.3",
    "stylelint": "^14.16.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard": "^25.0.0"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  }
}
